# Electronix E-Commerce: copia a '.env' con valores reales
# Base de datos PostgreSQL
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce_user
POSTGRES_PASSWORD=genera_una_contraseña_larga_y_unica

# Para ejecutar Spring Boot fuera de Docker (PostgreSQL se publica en 5435)
DB_URL=jdbc:postgresql://localhost:5435/ecommerce
DB_USER=ecommerce_user
DB_PASSWORD=genera_una_contraseña_larga_y_unica

# Puerto de la aplicación cuando se ejecuta fuera de Docker
PORT=8080

# Seguridad JWT (clave secreta de mínimo 256 bits)
JWT_SECRET=genera_una_clave_aleatoria_de_al_menos_32_caracteres
JWT_EXPIRATION=86400000

# Origenes permitidos para API y WS, separados por coma
CORS_ORIGINS=http://localhost:8090,http://localhost:8080,http://localhost:3000

# Datos de demostración: false para iniciar sin cuentas demo.
DEMO_SEED_ENABLED=false

# Cuenta administradora inicial. No publiques ni compartas el archivo .env real.
ADMIN_EMAIL=Admin@gmail.com
ADMIN_PASSWORD=cambia_esta_clave_por_una_segura

# Solo se usan si DEMO_SEED_ENABLED=true y la base no tiene usuarios.
# CLIENTE_PASSWORD=define_una_clave_demo_cliente
# DEMO_USER_PASSWORD=define_una_clave_para_usuarios_demo

# Uploads de apariencia (fondos y PNG): ruta local o /app/uploads en Docker
APP_UPLOAD_DIR=uploads
