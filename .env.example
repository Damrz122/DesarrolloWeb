# Electronix E-Commerce: copia a '.env' con valores reales
# Base de datos PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/ecommerce
DB_USER=postgres
DB_PASSWORD=tu_contraseña_aqui

# Puerto de la aplicación
PORT=8080

# Seguridad JWT (clave secreta de mínimo 256 bits)
JWT_SECRET=tu_clave_secreta_jwt_minimo_256_bits_aqui
JWT_EXPIRATION=86400000

# Origenes permitidos para API y WS, separados por coma
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# Seed demo: true en dev, false en prod
DEMO_SEED_ENABLED=true

# Claves demo: cambialas en prod
ADMIN_PASSWORD=cambia_esta_clave_admin
CLIENTE_PASSWORD=cambia_esta_clave_cliente

# Uploads de apariencia (fondos y PNG): ruta local o /app/uploads en Docker
APP_UPLOAD_DIR=uploads
