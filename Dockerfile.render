FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /build
COPY pom.xml .
RUN mvn -B -q dependency:go-offline
COPY src ./src
RUN mvn -B -q package -Dmaven.test.skip=true

FROM eclipse-temurin:21-jre-alpine
RUN addgroup -S electronix && adduser -S electronix -G electronix \
    && mkdir -p /app/uploads && chown -R electronix:electronix /app
WORKDIR /app
COPY --from=build --chown=electronix:electronix /build/target/*.jar /app/app.jar
USER electronix
ENV SPRING_PROFILES_ACTIVE=prod,cloud
ENV PORT=10000
ENV TZ=America/Lima
EXPOSE 10000
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
